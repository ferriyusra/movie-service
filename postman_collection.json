{
  "info": {
    "name": "Movie Reservation System",
    "description": "API collection for the Movie Reservation System backend.\n\n**Setup:**\n1. Start the server: `make dev`\n2. Login as admin first to get a token\n3. The collection uses variables for `baseUrl` and `accessToken`\n\n**Auth flow:**\n- Login/Register sets `accessToken` automatically via Tests script\n- All protected/admin requests use `{{accessToken}}` in the Authorization header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "genreId",
      "value": "",
      "type": "string"
    },
    {
      "key": "movieId",
      "value": "",
      "type": "string"
    },
    {
      "key": "theaterId",
      "value": "",
      "type": "string"
    },
    {
      "key": "showtimeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "seatId1",
      "value": "",
      "type": "string"
    },
    {
      "key": "seatId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.user) {",
                  "    pm.collectionVariables.set('userId', json.data.user.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cinema.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "List Genres (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Create Genre (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('genreId', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/genres",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Action\"\n}"
            }
          }
        },
        {
          "name": "Delete Genre (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/{{genreId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "List Movies (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/movies?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "title", "value": "", "disabled": true },
                { "key": "genreId", "value": "{{genreId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Movie (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/movies/{{movieId}}"
          }
        },
        {
          "name": "Create Movie (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('movieId', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/movies",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"description\": \"A thief who steals corporate secrets through dream-sharing technology.\",\n  \"posterUrl\": \"https://example.com/inception.jpg\",\n  \"durationMin\": 148,\n  \"language\": \"English\",\n  \"releaseDate\": \"2010-07-16\",\n  \"genreIds\": [\"{{genreId}}\"]\n}"
            }
          }
        },
        {
          "name": "Update Movie (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/movies/{{movieId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception (Updated)\",\n  \"description\": \"Updated description.\",\n  \"posterUrl\": \"https://example.com/inception2.jpg\",\n  \"durationMin\": 148,\n  \"language\": \"English\",\n  \"releaseDate\": \"2010-07-16\",\n  \"genreIds\": [\"{{genreId}}\"]\n}"
            }
          }
        },
        {
          "name": "Delete Movie (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/movies/{{movieId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Theaters",
      "item": [
        {
          "name": "List Theaters (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/theaters"
          }
        },
        {
          "name": "Get Theater (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/theaters/{{theaterId}}"
          }
        },
        {
          "name": "Create Theater (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('theaterId', json.data.id);",
                  "    if (json.data.seats && json.data.seats.length >= 2) {",
                  "      pm.collectionVariables.set('seatId1', json.data.seats[0].id);",
                  "      pm.collectionVariables.set('seatId2', json.data.seats[1].id);",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/theaters",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Theater 1\",\n  \"location\": \"Ground Floor, Building A\",\n  \"rows\": 5,\n  \"seatsPerRow\": 10\n}"
            }
          }
        },
        {
          "name": "Update Theater (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/theaters/{{theaterId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Theater 1 (Renovated)\",\n  \"location\": \"Ground Floor, Building A\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Showtimes",
      "item": [
        {
          "name": "List Showtimes by Date (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/showtimes?date=2026-04-10",
              "host": ["{{baseUrl}}"],
              "path": ["showtimes"],
              "query": [
                { "key": "date", "value": "2026-04-10" }
              ]
            }
          }
        },
        {
          "name": "Get Showtime (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/showtimes/{{showtimeId}}"
          }
        },
        {
          "name": "Create Showtime (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('showtimeId', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/showtimes",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"theaterId\": \"{{theaterId}}\",\n  \"startTime\": \"2026-04-10T14:00:00Z\",\n  \"price\": 50000\n}"
            }
          }
        },
        {
          "name": "Update Showtime (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/showtimes/{{showtimeId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"theaterId\": \"{{theaterId}}\",\n  \"startTime\": \"2026-04-10T17:00:00Z\",\n  \"price\": 55000\n}"
            }
          }
        },
        {
          "name": "Delete Showtime (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/showtimes/{{showtimeId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.data) {",
                  "    pm.collectionVariables.set('reservationId', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reservations",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showtimeId\": \"{{showtimeId}}\",\n  \"seatIds\": [\"{{seatId1}}\", \"{{seatId2}}\"]\n}"
            }
          }
        },
        {
          "name": "List My Reservations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reservations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "confirmed", "disabled": true }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "Get Reservation",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reservations/{{reservationId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/reservations/{{reservationId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List All Reservations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/reservations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reservations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "confirmed", "disabled": true },
                { "key": "userId", "value": "", "disabled": true },
                { "key": "showtimeId", "value": "", "disabled": true },
                { "key": "dateFrom", "value": "2026-01-01", "disabled": true },
                { "key": "dateTo", "value": "2026-12-31", "disabled": true }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "Cancel Any Reservation (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/reservations/{{reservationId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "Promote User to Admin",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/users/{{userId}}/promote",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    }
  ]
}
