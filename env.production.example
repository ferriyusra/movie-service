# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=7071
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Database Configuration
DATABASE_TYPE=postgres
DATABASE_DSN=postgresql://ferri:CHANGE_ME@postgres:5432/movie-service?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m

# Postgres container credentials (must match DATABASE_DSN)
POSTGRES_USER=ferri
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=movie-service

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Auth / Security (generate strong random secrets!)
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
CSRF_SECRET=CHANGE_ME
ALLOWED_ORIGINS=https://yourdomain.com

# Development Mode
DEV_MODE=false
